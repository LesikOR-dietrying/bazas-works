# Copy to .env; replace the password before starting Compose.
POSTGRES_DB=baza
POSTGRES_USER=baza
POSTGRES_PASSWORD=
JWT_SECRET=
# Лише для явної development-команди `python -m app.cli seed-demo`.
SEED_PASSWORD=
TRUSTED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Local Python development only. Compose supplies its own database host.
DATABASE_HOST=localhost
DATABASE_PORT=5432
APP_ENV=development
STORAGE_DIRECTORY=./storage
MAX_UPLOAD_BYTES=52428800
# JSON array, used only when the frontend runs on another origin.
CORS_ORIGINS=["http://localhost:5173"]
